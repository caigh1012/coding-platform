{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2020",
    "noImplicitAny": true,
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "strict": true,
    "jsx": "preserve",
    "removeComments": false,
    "moduleResolution": "bundler",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*", "globals.d.ts"]
}
